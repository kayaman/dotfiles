# dot-filter — secret-line patterns (ERE, case-insensitive)
# Lines in tracked files matching any pattern are replaced with
# '# [REDACTED by dot-filter]' in the git index at commit time.
# Working-tree files are never modified.
# Add patterns with: dot filter-add <pattern>

# Patterns require a real-looking value so that placeholders, empty
# assignments, and source code mentioning these names survive intact
# (the filter must be a no-op on the repo's own tracked content).
signingkey\s*=\s*"?[0-9A-Fa-f]{8,}
GITHUB_TOKEN\s*=\s*"?gh[a-z]_[A-Za-z0-9_]{10,}
GH_TOKEN\s*=\s*"?gh[a-z]_[A-Za-z0-9_]{10,}
OPENAI_API_KEY\s*=\s*"?sk-[A-Za-z0-9_-]{10,}
ANTHROPIC_API_KEY\s*=\s*"?sk-ant-[A-Za-z0-9_-]{10,}
# The generic patterns additionally require a digit in the value, so prose
# placeholders like "your_encrypted_openai_key" or "sk-..." stay intact.
password\s*=\s*"?[A-Za-z_@%+=:!-]*[0-9][A-Za-z0-9_@%+=:!-]{2,}
secret\s*=\s*"?[A-Za-z_@%+=:!-]*[0-9][A-Za-z0-9_@%+=:!-]{2,}
api_key\s*=\s*"?[A-Za-z_@%+=:!-]*[0-9][A-Za-z0-9_@%+=:!-]{2,}
