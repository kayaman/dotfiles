# ─────────────────────────────────────────────────────────────
#  ~/.blerc — ble.sh config (syntax highlighting only)
#  Tokyo Night colors
# ─────────────────────────────────────────────────────────────

# Commands: green if found, red if not
ble-face syntax_command='fg=#9ece6a'
ble-face syntax_command_builtin='fg=#7aa2f7'
ble-face syntax_command_alias='fg=#9ece6a'
ble-face syntax_command_function='fg=#9ece6a'
ble-face syntax_command_keyword='fg=#bb9af7'
ble-face command_file='fg=#9ece6a'

# Error: red for unknown commands
ble-face syntax_error='fg=#f7768e,bold'
ble-face command_not_found='fg=#f7768e,bold'

# Strings, variables, comments, operators
ble-face syntax_quoted='fg=#e0af68'
ble-face syntax_param_expansion='fg=#7dcfff'
ble-face syntax_comment='fg=#565f89,italic'
ble-face syntax_delimiter='fg=#89ddff'
ble-face syntax_glob='fg=#bb9af7,bold'

# Enable syntax highlighting
bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1

# Prompt: let starship handle it
bleopt prompt_ps1_transient=trim

# Silence bell
bleopt decode_error_cseq_abell=
bleopt decode_error_cseq_vbell=
bleopt decode_error_kseq_abell=
bleopt decode_error_kseq_vbell=
