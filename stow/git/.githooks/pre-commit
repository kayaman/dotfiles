#!/usr/bin/env bash
#
# pre-commit — block unsigned commits
# Verifies that GPG commit signing is properly configured before
# allowing a commit to proceed. Installed as a global Git hook.
#
# Bypass (emergency only):
#   git commit --no-verify -m "message"

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

error() { printf "${RED}[BLOCKED]${NC} %s\n" "$*" >&2; }
hint() { printf "${YELLOW}  ➜${NC} %s\n" "$*" >&2; }

# ── 1. Check commit.gpgsign is enabled ───────────────────────
gpgsign=$(git config --get commit.gpgsign 2>/dev/null || echo "false")
if [[ "$gpgsign" != "true" ]]; then
        echo >&2
        error "Commit signing is not enabled (commit.gpgsign != true)."
        hint "Run: git config --global commit.gpgsign true"
        hint "Or:  setup-gpg-signing"
        echo >&2
        exit 1
fi

# ── 2. Check user.signingkey is set ──────────────────────────
signingkey=$(git config --get user.signingkey 2>/dev/null || echo "")
if [[ -z "$signingkey" ]]; then
        echo >&2
        error "No GPG signing key configured (user.signingkey is empty)."
        hint "Run: setup-gpg-signing"
        hint "Or:  git config --global user.signingkey <KEY_ID>"
        echo >&2
        exit 1
fi

# ── 3. Verify the secret key is available in the keyring ─────
gpg_bin="gpg"
command -v gpg2 &>/dev/null && gpg_bin="gpg2"

if ! $gpg_bin --list-secret-keys --keyid-format=long "$signingkey" &>/dev/null; then
        echo >&2
        error "GPG secret key '$signingkey' not found in your keyring."
        hint "Import it or generate a new one: gpg --full-generate-key"
        hint "Then run: setup-gpg-signing"
        echo >&2
        exit 1
fi
