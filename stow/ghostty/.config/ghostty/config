# Ghostty Configuration - One Dark Two (Dark & Discrete)

# Font
font-family = JetBrainsMono Nerd Font
font-size = 14.5

# Cursor
cursor-style = block
cursor-style-blink = false

# Window
window-padding-x = 4
window-padding-y = 4
window-decoration = false
confirm-close-surface = false

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Colors (One Dark Two - Atom One palette, high-contrast foreground)
theme = One Dark Two
