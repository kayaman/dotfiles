# ─────────────────────────────────────────────────────────────
#  ~/.inputrc — readline configuration
# ─────────────────────────────────────────────────────────────

$include /etc/inputrc

# Case-insensitive completion
set completion-ignore-case on

# Treat hyphens and underscores as equivalent
set completion-map-case on

# Show all matches if ambiguous on first tab
set show-all-if-ambiguous on
set show-all-if-unmodified on

# Color files by type in completion
set colored-stats on
set visible-stats on

# Append / to directories, @ to symlinks
set mark-directories on
set mark-symlinked-directories on

# Don't page through completions
set page-completions off

# Show common prefix before cycling
set menu-complete-display-prefix on

# Don't ring the bell
set bell-style none

# Allow UTF-8 input and output
set input-meta on
set output-meta on
set convert-meta off

# ── Key bindings ─────────────────────────────────────────────

# Tab / Shift-Tab to cycle through completions
TAB: menu-complete
"\e[Z": menu-complete-backward

# Up/Down arrow: history search based on current input
"\e[A": history-search-backward
"\e[B": history-search-forward

# Ctrl+Left/Right: move by word
"\e[1;5C": forward-word
"\e[1;5D": backward-word

# Ctrl+Backspace: delete word backward
"\C-h": backward-kill-word

# Alt+.: insert last argument from previous command (like zsh)
"\e.": yank-last-arg
