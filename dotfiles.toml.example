# dotfiles.toml — personal configuration & secrets
# ─────────────────────────────────────────────────────────────────────────────
# USAGE
#   cp dotfiles.toml.example dotfiles.toml
#   Fill in your values.  dotfiles.toml is git-ignored (never committed).
#
# READING VALUES
#   dot config get  git.signingkey
#   dot config list secrets
#   dot config apply          # exports every key in [secrets] into the shell
#
# FILTERING SECRETS AT COMMIT TIME
#   dot filter-install        # one-time per machine; activates .dotfilter
# ─────────────────────────────────────────────────────────────────────────────


# ── Identity ─────────────────────────────────────────────────────────────────
[user]
name       = "Your Name"
email      = "you@example.com"
username   = "your_github_handle"   # used by scripts that call the GitHub API


# ── Git ──────────────────────────────────────────────────────────────────────
[git]
name       = "Your Name"
email      = "you@example.com"
signingkey = ""                      # Optional pin. Blank = auto-detect newest GPG secret key for this email.
# editor   = "nvim"                  # overrides $GIT_EDITOR / $EDITOR
# defaultbranch = "main"


# ── Shell secrets (exported by `dot config apply`) ───────────────────────────
# Every key here becomes an environment variable in the current session.
# Keep sensitive tokens here instead of in .zshrc / .bash_profile.
[secrets]
# GITHUB_TOKEN          = "ghp_..."
# GH_TOKEN              = "ghp_..."
# ANTHROPIC_API_KEY     = "sk-ant-..."
# OPENAI_API_KEY        = "sk-..."
# AWS_ACCESS_KEY_ID     = ""
# AWS_SECRET_ACCESS_KEY = ""
# DIGITALOCEAN_TOKEN    = ""
# NPM_TOKEN             = ""


# ── SSH ───────────────────────────────────────────────────────────────────────
[ssh]
# key        = "~/.ssh/id_ed25519"   # primary key added to ssh-agent on login
# github_key = "~/.ssh/github"       # separate key for GitHub (optional)
# work_key   = "~/.ssh/work"


# ── GPG ───────────────────────────────────────────────────────────────────────
[gpg]
# key_id = ""                        # same as git.signingkey if you use GPG commits


# ── Cloud providers ───────────────────────────────────────────────────────────
[aws]
# default_region  = "us-east-1"
# default_profile = "personal"

[gcloud]
# project = "my-project-id"
# region  = "us-central1"


# ── Tools / package managers ──────────────────────────────────────────────────
[tools]
# node_version   = "20"              # used by setup scripts (nvm / fnm)
# python_version = "3.12"            # used by setup scripts (uv)
# ruby_version   = "3.3"


# ── Features — toggle setup-script behaviour ──────────────────────────────────
# NOTE: illustrative placeholders — not yet read by any setup script.
[features]
# enable_kubernetes  = false
# enable_homebrew    = true
# enable_1password   = false
# enable_direnv      = true


# ── Snippets — control which snippets/ files are sourced ──────────────────────
# NOTE: illustrative — currently every snippets/*.sh is sourced unconditionally
# (see .zshrc); the per-snippet `false` toggle is not yet honored.
[snippets]
# nvm    = true
# bun    = true
# rbenv  = false
# direnv = true
# fzf    = true


# ── Machine-specific overrides ────────────────────────────────────────────────
# Use this section for settings that differ between machines.
# Read with: dot config get machine.role
[machine]
# role    = "personal"               # personal | work | server
# display = "hidpi"                  # hidpi | normal  (affects font sizes etc.)
# os      = "linux"                  # linux | macos
