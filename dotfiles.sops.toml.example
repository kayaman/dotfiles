# dotfiles.sops.toml.example - Encrypted Configuration and Secrets Template
# Copy this to dotfiles.sops.toml and encrypt it with SOPS using your preferred backend (e.g., age, PGP, AWS KMS)

[git]
# Global git configuration used by scripts/setup-git.sh
name = "Your Name"
email = "you@example.com"
signingkey = "<your-gpg-key-id>"

[secrets]
# Environment variables exported to every shell session
# GITHUB_TOKEN = "your_encrypted_github_token"
# OPENAI_API_KEY = "your_encrypted_openai_key"

[features]
# Illustrative placeholders — not yet read by any setup script.
# enable_kubernetes = false

[snippets]
# Illustrative — every snippets/*.sh is currently sourced unconditionally
# (see .zshrc); the per-snippet toggle is not yet honored.
# nvm = true
# bun = true